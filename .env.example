# このファイルを .env.local という名前でコピーして、値を書き換えてください
#   cp .env.example .env.local
# .env.local は .gitignore 済みなので GitHub には上がりません

# Anthropic（Claude）のAPIキー。https://console.anthropic.com/ で発行
ANTHROPIC_API_KEY=sk-ant-ここにあなたのAPIキー

# ログイン用のパスコード（1つだけ）。推測されにくい長めの文字列にしてください
APP_PASSCODE=ここにパスコード

# ログイン状態(Cookie)の改ざん防止に使う秘密の文字列（16文字以上）
# 生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ここにランダムな長い文字列

# （任意）使用するモデル。未指定なら claude-sonnet-5-5
# ANTHROPIC_MODEL=claude-sonnet-5-5
